[en-us]
  name         = "MeTube Download"
  auth         = "alexta69"
  version      = "@@VERSION@@"
  descript     = "MeTube Download is a web-based video downloader powered by yt-dlp: paste a link in your browser to download from YouTube, Bilibili and a thousand more sites, with batch queueing, automatic audio extraction, free choice of quality and output format, and channel subscriptions that track new releases automatically. This build is packaged for the TOS 7 App Center: it bundles a complete Python runtime with all dependencies, runs as a dedicated unprivileged user inside a hardened systemd sandbox, supports fully user-defined download directories at any absolute path, and ships a built-in PO Token provider for reliable YouTube access. Ready out of the box - a capable companion for building your home media library."
  release_note = "Bundles the CPython 3.13 runtime and all dependencies (no system Python requirement), a built-in PO Token provider service, and optional aria2 acceleration. No download directory is preconfigured: type any absolute path into the Download Folder field (grant the metube user access in your NAS sharing settings first) or set DOWNLOAD_DIR in /etc/metube/metube.env and run metube-apply-config. The chosen folder is remembered across restarts."
  important    = "Respect the copyright laws of your region and download only content you are entitled to. No default download directory is preset; downloads stay blocked until you explicitly choose one."

