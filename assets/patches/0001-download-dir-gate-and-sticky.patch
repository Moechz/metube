@@ -1,5 +1,26 @@
 import os
 import shutil
+
+# [metube-deb patch] Validation for UI-entered absolute download directories.
+# Usable = absolute, no ".." traversal, resolves outside system/runtime locations,
+# and is an existing directory writable by the current (unprivileged) user --
+# i.e. the NAS admin granted access through sharing permissions. Returns the
+# realpath on success, None otherwise.
+_METUBE_SYSTEM_PREFIXES = (
+    '/etc', '/usr', '/boot', '/bin', '/sbin', '/lib', '/lib32', '/lib64',
+    '/libx32', '/opt/metube', '/proc', '/sys', '/dev', '/run', '/home',
+)
+
+def _metube_validate_custom_root(path):
+    if not path.startswith('/') or '/../' in path or path.endswith('/..'):
+        return None
+    rp = os.path.realpath(path)
+    for p in _METUBE_SYSTEM_PREFIXES:
+        if rp == p or rp.startswith(p + '/'):
+            return None
+    if not os.path.isdir(rp) or not os.access(rp, os.W_OK | os.X_OK):
+        return None
+    return rp
