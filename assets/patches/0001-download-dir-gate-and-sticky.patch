 config = Config()
+
+# [metube-deb patch] ---- sticky UI-chosen download directory ----
+# The web UI cannot edit /etc configuration (the service runs unprivileged inside
+# a systemd sandbox). Instead, an absolute folder entered in the UI is validated
+# against the service user's own permissions (NAS sharing ACLs) and remembered in
+# the writable state dir; it is adopted as the effective download base at startup.
+def _metube_sticky_file():
+    return os.path.join(config.STATE_DIR, 'ui_download_dir')
+
+def _metube_load_sticky():
+    try:
+        with open(_metube_sticky_file()) as f:
+            return _metube_validate_custom_root(f.read().strip())
+    except OSError:
+        return None
+
+def _metube_save_sticky(path):
+    try:
+        with open(_metube_sticky_file(), 'w') as f:
+            f.write(path)
+    except OSError:
+        pass
+
+def _metube_adopt_sticky(path):
+    if not config.DOWNLOAD_DIR:
+        config.DOWNLOAD_DIR = path
+        if not config.AUDIO_DOWNLOAD_DIR:
+            config.AUDIO_DOWNLOAD_DIR = path
+        if not config.TEMP_DIR:
+            config.TEMP_DIR = path
+
+_metube_startup_sticky = _metube_load_sticky()
+if _metube_startup_sticky:
+    _metube_adopt_sticky(_metube_startup_sticky)
