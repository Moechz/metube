# ============================================================
# MeTube 配置文件（systemd EnvironmentFile 格式）
#
# 修改后需重启服务生效:  sudo systemctl restart metube
# 完整变量列表见上游文档:
#   https://github.com/Moechz/metube#environment-variables
# ============================================================

# ---- 网络与安全 ----
# 监听地址: 127.0.0.1=仅本机（默认；外部一律经 TOS nginx /metube/ 反代）
#             0.0.0.0=所有网卡(IPv4)，*=双栈 —— 如需局域网直连 http://NAS:8081 再打开
HOST=127.0.0.1
# Web 端口（浏览器访问 http://NAS的IP:PORT ）
PORT=8081
# HTTPS=true 时需提供 CERTFILE / KEYFILE
#HTTPS=false
#CERTFILE=
#KEYFILE=
# 反向代理下的子路径，例如 /metube/
# 部署子路径（TOS 应用中心 iframe 集成用：nginx 反代 /metube/ 到本服务）
# 保持与 /etc/nginx/conf.d/metube.conf 的 location 一致；留空则部署在根路径 /
URL_PREFIX=/metube/
#CORS_ALLOWED_ORIGINS=

# ---- 下载目录（必填，完全由您自定义，填任意绝对路径）----
# 下载目录（默认留空=未设置：网页点下载会被拦截并提示先配置）。
# 填任意绝对路径（目录无需预先存在，NAS 共享夹、独立盘挂载点等均可），
# 改完执行: metube-apply-config 生效（自动建目录/授权/应用沙箱白名单并重启服务）。
# 示例: DOWNLOAD_DIR=/你的/任意/路径
DOWNLOAD_DIR=
# 音频单独存放目录（默认跟随 DOWNLOAD_DIR：请保持本行注释状态！）
# 注意: 上游的"跟随"语义只在变量【未设置】时生效；若写 AUDIO_DOWNLOAD_DIR=
# 空值，systemd 会把空串传入进程，覆盖上游默认，导致音频/临时文件落到
# /opt/metube（CWD）且网页目录下拉框泄漏运行时内部目录。需要单独指定时
# 填绝对路径并取消注释。
#AUDIO_DOWNLOAD_DIR=
# 临时文件目录（默认跟随 DOWNLOAD_DIR：同上，保持注释状态）
#TEMP_DIR=
# 下载状态/队列持久化目录
STATE_DIR=/var/lib/metube/state
# 允许网页上直接浏览已下载文件目录
#DOWNLOAD_DIRS_INDEXABLE=false

# ---- 下载行为 ----
# 文件命名模板（yt-dlp 语法）
#OUTPUT_TEMPLATE=%(title)s [%(id)s].%(ext)s
# 倍速/画质等高级选项（JSON，含双引号时请用单引号包裹整个值）
#YTDL_OPTIONS='{"format": "bestvideo*+bestaudio/best"}'
# 存放 YTDL_OPTIONS 预设的 JSON 文件路径
#YTDL_OPTIONS_FILE=
# 并发下载数
#MAX_CONCURRENT_DOWNLOADS=3
# 完成记录保留秒数（0=永久）
#CLEAR_COMPLETED_AFTER=0
# 拖进回收站时是否删除文件
#DELETE_FILE_ON_TRASHCAN=false

# ---- 订阅 ----
# 订阅检查间隔（分钟）
#SUBSCRIPTION_DEFAULT_CHECK_INTERVAL=60

# ---- 其他 ----
# 日志级别: DEBUG / INFO / WARNING / ERROR
#LOGLEVEL=INFO
#ENABLE_ACCESSLOG=false
#DEFAULT_THEME=auto
