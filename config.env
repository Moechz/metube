# ============================================================
# MeTube deb 打包配置
# 修改后重新运行 ./build.sh 即可
# ============================================================

# MeTube 上游版本（GitHub tag）
METUBE_VERSION=2026.08.28

# 封装序列 id（同上游版本重复封装时递增；三位零填充：001、002…999、1000）
# 完整 deb 版本 = 上游版本-序列id，例如 2026.08.28-001
PKG_RELEASE=012

# 目标机 glibc 下限（TOS 7 = Ubuntu 22.04 = 2.35）；源码构建必须在不高于此
# 基线的环境里编译（CI 用 ubuntu:22.04 容器），verify 阶段断言符号不超限
GLIBC_FLOOR=2.35

# 目标架构（TOS NAS 的 CPU 架构）:
#   amd64 - Intel/AMD x86_64（绝大多数 TerraMaster 等 NAS）
#   arm64 - ARM64/aarch64 机型
TARGET_ARCH=amd64

# ---- 以下为捆绑组件版本（一般无需修改）----

# 捆绑的 CPython 运行时（版本号；source 模式从 python.org 官方源码构建，
# compat 模式回退用 python-build-standalone 的 release tag）
PBS_PYTHON=3.13.15
PBS_TAG=20260901
# python.org 官方源码包哈希（供应链固化；python-src 阶段强制校验）
CPYTHON_SRC_SHA256=c28d9d213c09b5b5ab2c29812950e12f746999e099b82894231be954b26baed9

# Node.js（仅构建前端时使用，不进入 deb）
NODE_VERSION=22.23.2

# Deno 已移除（-011）：应用与 Rust 版 bgutil 服务均不使用，捆绑纯死重（2×91MB）

# bgutil-ytdlp-pot-provider（YouTube PO Token；source 模式从 Rust 源码构建，
# compat 模式回退用上游 release 二进制）
BGUTIL_VERSION=v0.8.1

# deb 维护者信息
MAINTAINER="Moechz"
PUBLISHER="Moechz"