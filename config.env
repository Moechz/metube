# ============================================================
# MeTube deb 打包配置
# 修改后重新运行 ./build.sh 即可
# ============================================================

# MeTube 上游版本（GitHub tag）
METUBE_VERSION=2026.08.28

# 封装序列 id（同上游版本重复封装时递增；三位零填充：001、002…999、1000）
# 完整 deb 版本 = 上游版本-序列id，例如 2026.08.28-001
PKG_RELEASE=010

# 目标架构（TOS NAS 的 CPU 架构）:
#   amd64 - Intel/AMD x86_64（绝大多数 TerraMaster 等 NAS）
#   arm64 - ARM64/aarch64 机型
TARGET_ARCH=amd64

# ---- 以下为捆绑组件版本（一般无需修改）----

# 捆绑的 CPython 运行时（python-build-standalone: 版本号 + release tag）
PBS_PYTHON=3.13.15
PBS_TAG=20260901

# Node.js（仅构建前端时使用，不进入 deb）
NODE_VERSION=22.23.2

# Deno 运行时（yt-dlp[deno] 需要，进入 deb）
DENO_VERSION=2.9.6

# bgutil-ytdlp-pot-provider（YouTube PO Token，进入 deb）
BGUTIL_VERSION=v0.8.1

# deb 维护者信息
MAINTAINER="Moechz"
PUBLISHER="Moechz"